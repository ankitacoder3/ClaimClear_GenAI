[
  {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "input_schema": {
      "properties": {
        "case_id": {
          "anyOf": [
            {
              "pattern": "^case_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required with an uploaded wording (upload:doc_...)",
          "title": "Case Id"
        },
        "rule_ref": {
          "description": "A settlement-engine rule_ref, e.g. 'room_rent_cap', 'copay'",
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Rule Ref",
          "type": "string"
        },
        "wording_uin": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{7}\\d{5}V\\d{6}$|^upload:doc_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The case's wording (case-records get_policy wording_uin). Omit for the default wording.",
          "title": "Wording Uin"
        }
      },
      "required": [
        "rule_ref"
      ],
      "title": "clauses_for_ruleArguments",
      "type": "object"
    },
    "meta": {
      "access": "read"
    },
    "name": "clauses_for_rule",
    "output_schema": {
      "$defs": {
        "ClauseOut": {
          "additionalProperties": false,
          "properties": {
            "citation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Citation"
            },
            "clause_id": {
              "title": "Clause Id",
              "type": "string"
            },
            "codes": {
              "description": "IRDAI exclusion codes printed in the clause, e.g. Excl01",
              "items": {
                "type": "string"
              },
              "title": "Codes",
              "type": "array"
            },
            "found": {
              "description": "False when the wording has no such clause; then do not cite it",
              "title": "Found",
              "type": "boolean"
            },
            "page_end": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Page End"
            },
            "page_start": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Page Start"
            },
            "parent_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Parent Id"
            },
            "section": {
              "title": "Section",
              "type": "string"
            },
            "synthetic": {
              "title": "Synthetic",
              "type": "boolean"
            },
            "text": {
              "title": "Text",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "wording": {
              "$ref": "#/$defs/WordingOut"
            }
          },
          "required": [
            "found",
            "clause_id",
            "title",
            "section",
            "parent_id",
            "text",
            "page_start",
            "page_end",
            "codes",
            "citation",
            "wording",
            "synthetic"
          ],
          "title": "ClauseOut",
          "type": "object"
        },
        "WordingOut": {
          "additionalProperties": false,
          "description": "Which policy wording the clauses come from.",
          "properties": {
            "downloaded_on": {
              "description": "ISO date the wording was downloaded",
              "title": "Downloaded On",
              "type": "string"
            },
            "insurer": {
              "title": "Insurer",
              "type": "string"
            },
            "product": {
              "title": "Product",
              "type": "string"
            },
            "reviewed": {
              "description": "False for uploaded wordings: say the wording was not reviewed when quoting it",
              "title": "Reviewed",
              "type": "boolean"
            },
            "sha256": {
              "description": "SHA-256 of the downloaded file",
              "title": "Sha256",
              "type": "string"
            },
            "source": {
              "description": "catalogue: a reviewed, pre-stored wording; uploaded: the policyholder's own PDF",
              "enum": [
                "catalogue",
                "uploaded"
              ],
              "title": "Source",
              "type": "string"
            },
            "source_url": {
              "title": "Source Url",
              "type": "string"
            },
            "synthetic": {
              "description": "True for a test wording: never show its text to a user as policy wording",
              "title": "Synthetic",
              "type": "boolean"
            },
            "uin": {
              "description": "IRDAI unique identification number of the product",
              "title": "Uin",
              "type": "string"
            },
            "version": {
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "insurer",
            "product",
            "uin",
            "version",
            "source_url",
            "downloaded_on",
            "sha256",
            "synthetic",
            "source",
            "reviewed"
          ],
          "title": "WordingOut",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "clauses": {
          "description": "The first is the clause to cite; may be empty if the wording does not address the rule",
          "items": {
            "$ref": "#/$defs/ClauseOut"
          },
          "title": "Clauses",
          "type": "array"
        },
        "differs_from_engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when the wording and the settlement engine disagree; a verdict-policy decision",
          "title": "Differs From Engine"
        },
        "rule_ref": {
          "title": "Rule Ref",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "where": {
          "description": "Where in the clauses the rule is stated (reviewed note)",
          "title": "Where",
          "type": "string"
        },
        "wording": {
          "$ref": "#/$defs/WordingOut"
        }
      },
      "required": [
        "rule_ref",
        "where",
        "differs_from_engine",
        "clauses",
        "wording",
        "synthetic"
      ],
      "title": "RuleClausesOut",
      "type": "object"
    }
  },
