          "title": "Wording Uin",
          "type": "string"
        }
      },
      "required": [
        "wording_uin",
        "case_id",
        "document_id",
        "clause_count",
        "structure",
        "in_scope",
        "detected_uin",
        "catalogue_match",
        "reviewed",
        "warnings"
      ],
      "title": "RegisterUploadOut",
      "type": "object"
    }
