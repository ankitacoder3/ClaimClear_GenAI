  {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": false
    },
    "input_schema": {
      "$defs": {
        "PageIn": {
          "additionalProperties": false,
          "properties": {
            "page": {
              "maximum": 10000,
              "minimum": 1,
              "title": "Page",
              "type": "integer"
            },
            "text": {
              "description": "Visible text of the page only (case-records page.text), never hidden_text",
              "maxLength": 20000,
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "page",
            "text"
          ],
          "title": "PageIn",
          "type": "object"
        }
      },
      "properties": {
        "case_id": {
          "description": "The case the upload belongs to",
          "pattern": "^case_[0-9a-f]{16}$",
          "title": "Case Id",
          "type": "string"
        },
        "document_id": {
          "description": "The uploaded policy's document_id",
          "pattern": "^doc_[0-9a-f]{16}$",
          "title": "Document Id",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageIn"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "document_id",
        "pages"
      ],
      "title": "register_uploaded_wordingArguments",
      "type": "object"
    },
    "meta": {
      "access": "write",
      "caller": "app"
    },
    "name": "register_uploaded_wording",
    "output_schema": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "catalogue_match": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when the detected UIN is in the catalogue: the reviewed copy can be used instead",
          "title": "Catalogue Match"
        },
        "clause_count": {
          "title": "Clause Count",
          "type": "integer"
        },
        "detected_uin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detected Uin"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "in_scope": {
          "description": "False when the text doesn't look like an Arogya Sanjeevani policy",
          "title": "In Scope",
          "type": "boolean"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        },
        "structure": {
          "description": "pages: numbered clauses weren't recognised, so each page is one searchable chunk",
