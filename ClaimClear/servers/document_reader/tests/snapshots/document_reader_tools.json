            },
            "field_type": {
              "title": "Field Type",
              "type": "string"
            },
            "hidden": {
              "title": "Hidden",
              "type": "boolean"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "page": {
              "title": "Page",
              "type": "integer"
            },
            "value": {
              "title": "Value",
              "type": "string"
            }
          },
          "required": [
