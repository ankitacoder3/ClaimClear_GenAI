[
  {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "input_schema": {
      "properties": {
        "content_base64": {
          "description": "The file's bytes, base64-encoded",
          "maxLength": 34952536,
          "minLength": 4,
          "title": "Content Base64",
          "type": "string"
        },
        "media_type": {
          "description": "What the file is",
          "enum": [
            "application/pdf",
            "image/jpeg",
            "image/png"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "items": {
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1-based pages; default all",
          "title": "Pages"
        }
      },
      "required": [
        "content_base64",
        "media_type"
      ],
      "title": "read_documentArguments",
      "type": "object"
    },
    "meta": {
      "access": "read",
      "caller": "app"
    },
    "name": "read_document",
