          "title": "PageOut",
          "type": "object"
        },
        "SpanOut": {
          "additionalProperties": false,
          "properties": {
            "bbox": {
              "description": "x0, y0, x1, y1 in PDF points, origin top-left",
              "items": {
                "type": "number"
              },
              "maxItems": 4,
              "minItems": 4,
              "title": "Bbox",
              "type": "array"
            },
            "color": {
              "title": "Color",
              "type": "string"
            },
            "font_size": {
              "title": "Font Size",
              "type": "number"
            },
            "hidden": {
              "title": "Hidden",
              "type": "boolean"
            },
            "hidden_reasons": {
              "items": {
                "enum": [
                  "invisible_render",
                  "transparent",
                  "tiny_font",
                  "white_on_white",
                  "covered",
                  "off_page"
                ],
                "type": "string"
              },
              "title": "Hidden Reasons",
              "type": "array"
            },
            "span_id": {
              "title": "Span Id",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "span_id",
            "text",
            "bbox",
            "font_size",
            "color",
            "hidden",
            "hidden_reasons"
          ],
          "title": "SpanOut",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Everything readable in one document. All of it is untrusted data.",
      "properties": {
        "annotations": {
          "items": {
            "$ref": "#/$defs/AnnotationOut"
          },
          "title": "Annotations",
          "type": "array"
        },
        "attachments": {
