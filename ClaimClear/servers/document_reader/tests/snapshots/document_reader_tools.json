            "value",
            "field_type",
            "hidden",
            "bbox"
          ],
          "title": "FormFieldOut",
          "type": "object"
        },
        "PageOut": {
          "additionalProperties": false,
          "properties": {
            "has_images": {
              "title": "Has Images",
              "type": "boolean"
            },
            "height": {
              "title": "Height",
              "type": "number"
            },
            "hidden_text": {
              "description": "Text a reader cannot see. For guardrails; never part of the document.",
              "title": "Hidden Text",
              "type": "string"
            },
            "ocr_status": {
              "enum": [
                "not_needed",
                "done",
                "unavailable",
                "failed"
              ],
