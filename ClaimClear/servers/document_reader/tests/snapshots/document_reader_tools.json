          "type": "array"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "page_count": {
          "title": "Page Count",
          "type": "integer"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageOut"
          },
          "title": "Pages",
          "type": "array"
        },
        "pages_returned": {
          "items": {
            "type": "integer"
          },
          "title": "Pages Returned",
          "type": "array"
        },
        "pdf_flags": {
          "items": {
            "type": "string"
          },
          "title": "Pdf Flags",
          "type": "array"
        },
        "untrusted_content": {
          "title": "Untrusted Content",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
