  {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "input_schema": {
      "properties": {},
      "title": "reader_statusArguments",
      "type": "object"
    },
    "meta": {
      "access": "read",
      "caller": "app"
    },
    "name": "reader_status",
    "output_schema": {
      "$defs": {
        "OcrStatusOut": {
          "additionalProperties": false,
          "properties": {
            "dpi": {
              "title": "Dpi",
              "type": "integer"
            },
            "enabled": {
              "description": "The reader will OCR image-only pages",
              "title": "Enabled",
              "type": "boolean"
            },
            "engine": {
              "const": "tesseract",
              "title": "Engine",
              "type": "string"
            },
            "installed": {
              "description": "Tesseract and its language data were found",
              "title": "Installed",
              "type": "boolean"
            },
            "installed_languages": {
              "items": {
                "type": "string"
              },
              "title": "Installed Languages",
              "type": "array"
            },
            "language": {
              "title": "Language",
              "type": "string"
            },
            "missing_languages": {
              "description": "Languages asked for but not installed; OCR on them fails",
              "items": {
                "type": "string"
              },
              "title": "Missing Languages",
              "type": "array"
            }
          },
          "required": [
            "engine",
            "installed",
            "enabled",
            "language",
            "dpi",
            "installed_languages",
            "missing_languages"
          ],
          "title": "OcrStatusOut",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "cache": {
          "description": "Results are cached by file content, so a file is OCR'd only once",
          "title": "Cache",
          "type": "boolean"
        },
        "max_bytes": {
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_pages": {
          "title": "Max Pages",
          "type": "integer"
        },
        "media_types": {
          "items": {
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ],
            "type": "string"
          },
          "title": "Media Types",
          "type": "array"
        },
        "ocr": {
          "$ref": "#/$defs/OcrStatusOut"
        },
        "version": {
          "description": "Reader version; results cached under another version are not reused",
          "title": "Version",
          "type": "string"
        }
