{
 "AnalystHandoff": {
  "additionalProperties": false,
  "description": "Policy analyst -> supervisor: the policy, earlier claims and the clauses found.",
  "properties": {
   "clauses": {
    "additionalProperties": {
     "additionalProperties": true,
     "type": "object"
    },
    "description": "clause_id -> get_clause result",
    "title": "Clauses",
    "type": "object"
   },
   "history": {
    "description": "case-records PastClaimOut, unchanged",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "title": "History",
    "type": "array"
   },
   "policy": {
    "additionalProperties": true,
    "description": "case-records PolicyOut, unchanged",
    "title": "Policy",
    "type": "object"
   }
  },
  "required": [
   "policy"
  ],
  "title": "AnalystHandoff",
  "type": "object"
 },
 "AuditorHandoff": {
  "additionalProperties": false,
  "description": "Settlement auditor -> supervisor: the engine's settlement and a verdict per letter row.",
  "properties": {
   "questions": {
    "description": "QuestionOut to ask through interrupt()",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "title": "Questions",
    "type": "array"
   },
   "replanned_rows": {
    "description": "Rows re-tested with every hypothesis after a partial test (replan trace)",
    "items": {
     "type": "string"
    },
    "title": "Replanned Rows",
    "type": "array"
   },
   "row_audits": {
    "additionalProperties": {
     "additionalProperties": true,
     "type": "object"
    },
    "description": "row_id -> RowAuditOut",
    "title": "Row Audits",
    "type": "object"
   },
   "settlement": {
    "additionalProperties": true,
    "description": "settlement-engine SettlementOut",
    "title": "Settlement",
    "type": "object"
   }
  },
  "required": [
   "settlement"
  ],
  "title": "AuditorHandoff",
  "type": "object"
 },
