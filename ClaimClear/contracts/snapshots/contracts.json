 "CriticReport": {
  "$defs": {
   "CriticFailure": {
    "additionalProperties": false,
    "properties": {
     "check": {
      "enum": [
       "figure_not_from_engine",
       "verdict_wording",
       "disputable_total",
       "clause_not_found",
       "forbidden_phrase"
      ],
      "title": "Check",
      "type": "string"
     },
     "detail": {
      "title": "Detail",
      "type": "string"
     }
    },
    "required": [
     "check",
     "detail"
    ],
    "title": "CriticFailure",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "description": "Critic -> supervisor. ``attempt`` 2 that fails means: fall back to the plain verdict table.",
  "properties": {
   "attempt": {
    "default": 1,
    "enum": [
     1,
     2
    ],
    "title": "Attempt",
    "type": "integer"
   },
   "disputable_amount": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "letter_audit.disputable_amount",
    "title": "Disputable Amount"
   },
   "failures": {
    "items": {
     "$ref": "#/$defs/CriticFailure"
    },
    "title": "Failures",
    "type": "array"
   },
   "passed": {
    "title": "Passed",
    "type": "boolean"
   }
  },
  "required": [
   "passed"
  ],
  "title": "CriticReport",
  "type": "object"
 },
 "ERROR_CODES": {
  "case-records": {
   "CASE_NOT_FOUND": "no such case: the app gave a wrong case_id",
   "DOCUMENT_INTEGRITY": "the stored copy is missing or changed: ask the user to upload it again",
   "DOCUMENT_NOT_IN_CASE": "the document belongs to another case (or doesn't exist)",
   "FILE_TOO_LARGE": "upload path: the file is over 25 MB",
   "INVALID_POLICY": "upload path: setting a case's policy number to an empty value (set_policy)",
   "INVALID_ROLE": "upload path: a document role that doesn't exist",
   "INVALID_SCOPE": "claim-history scope not recognised",
   "INVALID_WORDING": "upload path: a wording UIN in the wrong format",
   "POLICY_NOT_FOUND": "no pre-stored schedule for the policy: extract it from the uploaded policy and confirm",
   "UNSUPPORTED_MEDIA_TYPE": "upload path: only PDF, JPG and PNG are accepted"
  },
  "document-reader": {
   "DOCUMENT_ENCRYPTED": "the PDF is password-protected: ask for an unprotected copy",
   "DOCUMENT_TOO_LARGE": "the file is over 25 MB",
   "DOCUMENT_UNREADABLE": "empty, missing or can't be opened: ask for another copy",
   "INVALID_CONTENT": "content_base64 is not valid base64",
   "MEDIA_TYPE_MISMATCH": "the bytes are not the declared type (a renamed file)",
   "PAGE_OUT_OF_RANGE": "a requested page doesn't exist",
   "UNSUPPORTED_MEDIA_TYPE": "only PDF, JPG and PNG are read"
  },
  "insurer-portal": {
   "APPROVAL_REQUIRED": "no valid approval token for this exact letter: go back to the approval gate",
   "GRIEVANCE_NOT_FOUND": "no grievance with that reference",
   "TEXT_HASH_MISMATCH": "the letter changed after approval: get a fresh approval"
  },
  "memory": {
   "BAD_TRANSITION": "a grievance status change the lifecycle doesn't allow",
   "CLAIM_MISMATCH": "the audit belongs to another claim",
   "CLAIM_NOT_FOUND": "no remembered claim with that ID",
   "GRIEVANCE_NOT_FOUND": "no grievance with that ID for this user",
   "INVALID_HASH": "the approved text's hash is not a SHA-256",
   "INVALID_USER": "user_id is not the app's opaque ID",
   "MISSING_FIELD": "the case or audit lacks a field memory needs",
   "NOTHING_TO_DISPUTE": "the audit found nothing disputable: no grievance",
   "NOT_FINAL": "the audit still needs the user's answers: only final audits are stored",
   "NO_CONSENT": "the user has not agreed to the memory policy: nothing is stored",
   "POLICY_VERSION": "consent was given to an older memory policy: ask again",
   "ROW_NOT_DISPUTABLE": "a grievance on a row the audit did not find disputable",
   "SCHEMA_VERSION": "the memory database is from a newer version"
  },
  "policy-kb": {
   "EMPTY_QUERY": "the search query is empty after cleaning",
   "INDEX_UNAVAILABLE": "the wording's index isn't built: run python -m policy_kb build",
   "NO_RULE_MAP": "the wording has no rule map (uploaded wordings): use search_clauses",
   "UNKNOWN_RULE": "a rule_ref the rule map doesn't have",
   "UNKNOWN_WORDING": "a wording UIN that isn't in the catalogue or the case",
   "UPLOAD_REJECTED": "the uploaded policy could not be indexed (out of scope or unreadable)",
   "UPSTREAM_UNAVAILABLE": "the embedding or rewriting service is down: retryable"
  },
  "settlement-engine": {
   "HISTORY_POLICY_MISMATCH": "the history holds claims on another policy: pass get_claim_history unchanged",
   "POLICY_MISMATCH": "claim.policy_no and policy.policy_no differ: load the case's own policy (get_policy)",
   "ROW_NOT_FOUND": "no such row on the letter: the message lists the valid row IDs",
   "UNKNOWN_HYPOTHESIS": "a hypothesis ID that doesn't exist: call list_hypotheses"
  }
 },
 "ExplainerDraft": {
  "$defs": {
   "ExplanationSentence": {
    "additionalProperties": false,
    "properties": {
     "clause_ids": {
      "items": {
       "type": "string"
      },
      "title": "Clause Ids",
      "type": "array"
     },
     "fact_ids": {
      "description": "settlement facts the sentence states, e.g. F-PAYABLE",
      "items": {
       "type": "string"
      },
      "title": "Fact Ids",
      "type": "array"
     },
     "row_ids": {
      "items": {
       "type": "string"
      },
      "title": "Row Ids",
      "type": "array"
     },
     "text": {
      "maxLength": 600,
      "minLength": 1,
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "title": "ExplanationSentence",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "description": "Explainer -> critic: every sentence tied to the facts, rows or clauses it states.",
  "properties": {
   "sentences": {
    "items": {
     "$ref": "#/$defs/ExplanationSentence"
    },
    "minItems": 1,
    "title": "Sentences",
    "type": "array"
   }
  },
  "required": [
   "sentences"
  ],
  "title": "ExplainerDraft",
  "type": "object"
 },
 "FIELD_SHAPES": {
  "answers": {
   "filled_by": "user, via interrupt()",
   "note": "applied with claimclear_tools.case.apply_answer",
   "read_by": "auditor (re-run)",
   "schema": null
  },
  "case_id": {
   "filled_by": "app (Member 4), at upload",
   "note": "pattern case_[0-9a-f]{16}",
   "read_by": "everyone",
   "schema": null
  },
  "claim": {
   "filled_by": "document reader (structured extraction)",
   "note": "",
   "read_by": "auditor, critic",
   "schema": "ClaimIn"
  },
  "clauses": {
   "filled_by": "policy analyst <- get_clause / clauses_for_rule",
   "note": "",
   "read_by": "explainer, critic",
   "schema": "ClauseOut"
  },
  "critic": {
   "filled_by": "critic",
   "note": "",
   "read_by": "supervisor",
   "schema": "CriticReport"
  },
  "documents": {
   "filled_by": "document reader <- list_case_documents",
   "note": "",
   "read_by": "document reader",
   "schema": "DocumentInfoOut"
  },
  "draft": {
   "filled_by": "explainer",
   "note": "",
   "read_by": "critic, output guardrails",
   "schema": "ExplainerDraft"
  },
  "grievance": {
   "filled_by": "grievance agent",
   "note": "",
   "read_by": "approval gate (Member 4)",
   "schema": "GrievanceDraft"
  },
  "history": {
   "filled_by": "policy analyst <- get_claim_history",
   "note": "",
   "read_by": "auditor, critic",
   "schema": "PastClaimOut"
  },
  "letter": {
   "filled_by": "document reader (structured extraction)",
   "note": "",
   "read_by": "auditor, critic, grievance agent",
   "schema": "LetterIn"
  },
  "letter_audit": {
   "filled_by": "critic <- audit_settlement_letter",
   "note": "",
   "read_by": "critic, explainer",
   "schema": "LetterAuditOut"
  },
  "memory": {
   "filled_by": "supervisor <- claimclear_memory context()",
   "note": "",
   "read_by": "everyone; critic takes figures",
   "schema": null
  },
  "pages": {
   "filled_by": "document reader <- get_document_text",
   "note": "",
   "read_by": "document reader, guardrails",
   "schema": "DocumentTextOut"
  },
  "plan": {
   "filled_by": "supervisor",
   "note": "",
   "read_by": "everyone; shown to the user",
   "schema": "Plan"
  },
  "policy": {
   "filled_by": "policy analyst <- get_policy",
   "note": "",
   "read_by": "auditor, critic",
   "schema": "PolicyOut"
  },
  "questions": {
   "filled_by": "from settlement and row_audits",
   "note": "",
   "read_by": "supervisor -> interrupt()",
   "schema": "QuestionOut"
  },
  "row_audits": {
   "filled_by": "auditor <- reproduce_deduction",
   "note": "",
   "read_by": "explainer, critic, grievance agent",
   "schema": "RowAuditOut"
  },
  "security_flags": {
   "filled_by": "guardrails (Member 4)",
   "note": "",
   "read_by": "supervisor",
   "schema": null
  },
  "settlement": {
   "filled_by": "auditor <- expected_settlement",
   "note": "",
   "read_by": "auditor, explainer, critic",
   "schema": "SettlementOut"
  },
  "sources": {
   "filled_by": "document reader",
   "note": "{field path: span_id}",
   "read_by": "UI highlighting, critic",
   "schema": null
  },
  "user_id": {
   "filled_by": "app (Member 4), from the session",
   "note": "",
   "read_by": "memory",
   "schema": null
  },
  "wording": {
   "filled_by": "policy analyst <- get_policy_wording",
   "note": "",
   "read_by": "supervisor (asks for the user's wording when wording_needed), explainer",
   "schema": "WordingOut"
  }
 },
 "GrievanceDraft": {
  "additionalProperties": false,
  "description": "Grievance agent -> approval gate: the exact text and its SHA-256, on disputable rows only.",
  "properties": {
   "case_id": {
    "pattern": "^case_[0-9a-f]{16}$",
    "title": "Case Id",
    "type": "string"
   },
   "claim_id": {
    "maxLength": 100,
    "minLength": 1,
    "title": "Claim Id",
    "type": "string"
   },
   "row_ids": {
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "title": "Row Ids",
    "type": "array"
   },
   "text": {
    "maxLength": 20000,
    "minLength": 1,
    "title": "Text",
    "type": "string"
   },
   "text_sha256": {
    "pattern": "^[0-9a-f]{64}$",
    "title": "Text Sha256",
    "type": "string"
   }
  },
  "required": [
   "case_id",
   "claim_id",
   "row_ids",
   "text",
   "text_sha256"
  ],
  "title": "GrievanceDraft",
  "type": "object"
 },
 "Plan": {
  "$defs": {
   "PlanStep": {
    "additionalProperties": false,
    "properties": {
     "agent": {
      "enum": [
       "supervisor",
       "document_reader",
       "policy_analyst",
       "settlement_auditor",
       "critic",
       "explainer",
       "grievance_agent"
      ],
      "title": "Agent",
      "type": "string"
     },
     "goal": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
     },
     "status": {
      "default": "pending",
      "enum": [
       "pending",
       "running",
       "done",
       "skipped",
       "failed"
      ],
      "title": "Status",
      "type": "string"
     },
     "step_id": {
      "pattern": "^S\\d+$",
      "title": "Step Id",
      "type": "string"
     }
    },
    "required": [
     "step_id",
     "agent",
     "goal"
    ],
    "title": "PlanStep",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "description": "The plan the supervisor shows the user. A replan bumps ``version`` and says why.",
  "properties": {
   "replan_reason": {
    "default": "",
    "description": "Empty for the first plan; the tool result that contradicted it",
    "title": "Replan Reason",
    "type": "string"
   },
   "steps": {
    "items": {
     "$ref": "#/$defs/PlanStep"
    },
    "minItems": 1,
    "title": "Steps",
    "type": "array"
   },
   "version": {
    "default": 1,
    "minimum": 1,
    "title": "Version",
    "type": "integer"
   }
  },
  "required": [
   "steps"
  ],
  "title": "Plan",
  "type": "object"
 },
 "ReaderHandoff": {
  "$defs": {
   "UnreadablePage": {
    "additionalProperties": false,
    "properties": {
     "document_id": {
      "pattern": "^doc_[0-9a-f]{16}$",
      "title": "Document Id",
      "type": "string"
     },
     "pages": {
      "items": {
       "type": "integer"
      },
      "minItems": 1,
      "title": "Pages",
      "type": "array"
     },
     "reason": {
      "enum": [
       "ocr_unavailable",
       "ocr_failed",
       "unreadable"
      ],
      "title": "Reason",
      "type": "string"
     }
    },
    "required": [
     "document_id",
     "pages",
     "reason"
    ],
    "title": "UnreadablePage",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "description": "Document reader -> supervisor: what the documents say, each field with its source span.",
  "properties": {
   "case_id": {
    "pattern": "^case_[0-9a-f]{16}$",
    "title": "Case Id",
    "type": "string"
   },
   "claim": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "settlement-engine ClaimIn",
    "title": "Claim"
   },
   "letter": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "settlement-engine LetterIn",
    "title": "Letter"
   },
   "sources": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "field path -> span_id",
    "title": "Sources",
    "type": "object"
   },
   "unreadable": {
    "description": "Pages that could not be read: take the missing-document edge",
    "items": {
     "$ref": "#/$defs/UnreadablePage"
    },
    "title": "Unreadable",
    "type": "array"
   }
  },
  "required": [
   "case_id"
  ],
  "title": "ReaderHandoff",
  "type": "object"
 },
 "ToolErrorPayload": {
  "additionalProperties": false,
  "properties": {
   "code": {
    "pattern": "^[A-Z][A-Z0-9_]+$",
    "title": "Code",
    "type": "string"
   },
   "message": {
    "title": "Message",
    "type": "string"
   },
   "retryable": {
    "default": false,
    "title": "Retryable",
    "type": "boolean"
   }
  },
  "required": [
   "code",
   "message"
  ],
  "title": "ToolErrorPayload",
  "type": "object"
 },
 "VERDICT_WORDING": {
  "does_not_match_policy+": "may be disputable",
  "does_not_match_policy-": "the insurer deducted less than your policy allows",
  "matches_policy": "matches your policy",
  "method_matches": "worked out correctly, but on the insurer's figures",
  "not_verifiable": "we can't check this without more information"
 }
}
