# Copy this file to .env (git-ignored) and fill in your own values. Never commit .env.
# Each member and CI should use their own OpenRouter key with a credit limit (see the plan).

OPENROUTER_API_KEY=

# Optional: pin models (record the IDs in the experiment log). Defaults shown.
# CLAIMCLEAR_EMBEDDING_MODEL=baai/bge-m3
# CLAIMCLEAR_REWRITE_MODEL=openai/gpt-4.1-mini

# ---- Chat model for the web UI and the document reader ----
# A local LLM is used first, so medical records never leave this machine. start_llm.bat / ./start_llm.sh starts
# one and writes these two lines for you. start.py also picks a running Ollama / LM Studio / llama.cpp by itself.
# CLAIMCLEAR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CLAIMCLEAR_LOCAL_MODEL=llama3.1:8b
# Otherwise OpenRouter (the key above). Optional model name (default openai/gpt-4.1-mini):
# CLAIMCLEAR_CHAT_MODEL=
# Optional: a different model only for reading the uploaded documents (default: the chat model above):
# CLAIMCLEAR_EXTRACTION_MODEL=
# Set to 0 to keep OpenRouter even when a local LLM is running (the web UI writes it when you choose OpenRouter):
# CLAIMCLEAR_AUTO_LOCAL=0
# With neither, answers come from your records, the audit and the policy wording (no model).
# Optional: the longest reply the model may write (default 1500 tokens). ClaimClear always sends a limit, so a key
# with a small credit limit (e.g. an OpenRouter key limited to 25,000 tokens) is not refused.
# CLAIMCLEAR_MAX_TOKENS=1500

# ---- LangSmith: eval tracking (ui_judge_eval.py --track) and traces of chats and reviews (optional) ----
# Key: LangSmith > Settings > API Keys (Personal Access Token, lsv2_pt_...)
# LANGSMITH_API_KEY=<Put LangSmith key here>
# true = send a trace of every chat and review run
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=claimclear-dev
# Your account's region; without it a non-US key gets 403 Forbidden. APAC shown; EU: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com

# ---- Security: input guards on uploads and chat (ClaimClear/security; experiment E2) ----
# off = no checks (the E2 baseline). Default on.
# CLAIMCLEAR_DEFENCES=on
# Which guards run: rules (keywords, free), safeguard (openai/gpt-oss-safeguard-20b on OpenRouter, cheap).
# Also available for comparison: llm (our model), llamaguard, nemotron. The key must allow the guard models.
# CLAIMCLEAR_GUARDS=rules,safeguard
# Optional: another model for the safeguard guard (it sends our written policy, so any instruction model works):
# CLAIMCLEAR_GUARD_MODEL_SAFEGUARD=openai/gpt-oss-safeguard-20b

# ---- Evaluation (ui_chainlit/ui_judge_eval.py; each also has a command-line option, which wins) ----
# The LLM judge; the course guide wants another model family than the chat model (--judge-model):
# CLAIMCLEAR_JUDGE_MODEL=openai/gpt-4.1-mini
# Signature 2 (E4): fact_bound (default) or free, the free-form baseline (--explainer):
# CLAIMCLEAR_EXPLAINER=fact_bound
# Playbook (E3): off (default) or on; lessons in agents/orchestration/claimclear_graph/playbook.json:
# CLAIMCLEAR_PLAYBOOK=off
